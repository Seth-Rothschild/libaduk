{
  "name": "libaduk-svelte",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "npm run format && vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo '' && git config core.hooksPath .githooks && chmod +x .githooks/commit-msg .githooks/pre-commit",
    "postinstall": "cp node_modules/onnxruntime-web/dist/*.wasm node_modules/onnxruntime-web/dist/*.mjs static/wasm/",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test:unit": "vitest",
    "typecheck": "sh scripts/typecheck.sh",
    "test": "npm run format && npm run typecheck && npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/sveltekit": "^10.5.4",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "^26.1.1",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-storybook": "^10.5.4",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.5.4",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-svelte": "^3.0.0"
  },
  "dependencies": {
    "@sabaki/boardmatcher": "^1.3.0",
    "@sabaki/go-board": "^1.4.3",
    "@sabaki/influence": "^1.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@sveltejs/adapter-node": "^5.5.7",
    "goban-engine": "^8.3.226",
    "mongodb": "^7.5.0",
    "onnxruntime-web": "^1.27.0",
    "qrcode": "^1.5.4",
    "ws": "^8.21.1"
  }
}
